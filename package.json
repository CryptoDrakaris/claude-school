{
  "name": "claude-school",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:typo": "node scripts/check-typo.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run check:typo && npm run check:secrets && npm run test:sql && npm run build",
    "prepare": "git config core.hooksPath .githooks",
    "test:sql": "node tests/sql.test.mjs",
    "test:rls": "node --env-file=.env tests/rls.test.mjs",
    "seed:keys": "node --env-file=.env scripts/seed-keys.mjs",
    "test:student": "node --env-file=.env scripts/test-student-link.mjs"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/marck-script": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
