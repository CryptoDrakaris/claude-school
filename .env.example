# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Публичные значения: попадают в сборку сайта (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Секретный ключ service role: только локально, для npm run seed:keys и теста RLS.
# Никогда не начинать с VITE_ – иначе он попадёт в сборку.
SUPABASE_SERVICE_ROLE_KEY=
